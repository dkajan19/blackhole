<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:keepScreenOn="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.jetradarmobile.snowfall.SnowfallView
        android:id="@+id/snowfallView"
        android:layout_width="match_parent"
        app:snowflakeSpeedMin="1"
        app:snowflakeSizeMin="2dp"
        app:snowflakeSizeMax="5dp"
        app:snowflakesNum="40"
        app:snowflakeSpeedMax="2"
        android:layout_height="match_parent"/>

    <!--  app:snowflakeImage="@drawable/snowflake" -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/loadingGif"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:src="@drawable/blackhole"
            android:visibility="gone" />

        <TextView
            android:id="@+id/downloadInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/percentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="0%"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="Click on the button below."
            android:textAlignment="center"
            android:paddingTop="25dp"
            android:textStyle="bold"
            android:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            app:icon="@drawable/download"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/information_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="start"
            android:layout_margin="5dp"
            android:src="@drawable/information"
            android:contentDescription="API Information"
            android:visibility="visible"
            android:tint="@android:color/darker_gray"/>

        <LinearLayout
            android:id="@+id/api_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/api_text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/api_provider"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/api_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/api_info"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />


            <!-- Supported Services Section -->
            <TextView
                android:id="@+id/supported_services_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Supported Services"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold|italic"
                android:layout_marginTop="30dp" />

            <TextView
                android:id="@+id/supported_services_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/platforms"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/github_footer"
        android:padding="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/github_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/github"
            android:contentDescription="GitHub Icon"
            android:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/github_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Feedback &amp; Bugs"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>
</FrameLayout>